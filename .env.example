# Public Firebase web app configuration (NOT a Gemini key or service-account key).
VITE_FIREBASE_CONFIG={"apiKey":"YOUR_FIREBASE_WEB_API_KEY","authDomain":"YOUR_PROJECT.firebaseapp.com","projectId":"YOUR_PROJECT","storageBucket":"YOUR_PROJECT.firebasestorage.app","messagingSenderId":"YOUR_SENDER_ID","appId":"YOUR_APP_ID"}
# Keep Nano Banana Pro as default. Override only if Google changes the available model ID.
VITE_GEMINI_MODEL=gemini-3-pro-image
