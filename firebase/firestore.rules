rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validSlot(slot, kind) {
      return (kind == 'identity' && slot.matches('identity-([0-9]|1[0-9])'))
        || (kind == 'swap' && slot.matches('swap-([0-9]|[1-9][0-9])'));
    }
    function fileValid(image, path, version, maxBytes, maxSide) {
      return image is map
        && image.keys().hasAll(['path', 'name', 'mimeType', 'width', 'height', 'version', 'bytes'])
        && image.path == path && image.version == version
        && image.bytes is int && image.bytes > 0 && image.bytes <= maxBytes
        && image.name is string && image.name.size() <= 255
        && image.mimeType in ['image/png', 'image/jpeg', 'image/webp']
        && image.width is int && image.width > 0 && image.width <= maxSide
        && image.height is int && image.height > 0 && image.height <= maxSide;
    }
    function imageValid(image, view, d) {
      return fileValid(image, 'library/' + d.slot + '/' + view, d.id, 16 * 1024 * 1024, 16384)
        && image.keys().hasOnly(['path', 'name', 'mimeType', 'width', 'height', 'version', 'bytes', 'thumbnail'])
        && (!('thumbnail' in image) || (
          fileValid(image.thumbnail, 'library/' + d.slot + '/' + view + '-thumb', d.id, 128 * 1024, 480)
          && image.thumbnail.mimeType == 'image/jpeg'
          && image.thumbnail.keys().hasOnly(['path', 'name', 'mimeType', 'width', 'height', 'version', 'bytes'])));
    }
    function sameSwapDimensions(d) {
      let base = get(/databases/$(database)/documents/records/$(d.identityId)).data.assets;
      return d.assets.front.width == base.front.width && d.assets.front.height == base.front.height
        && d.assets.back.width == base.back.width && d.assets.back.height == base.back.height;
    }
    function validRecord(recordId) {
      let d = request.resource.data;
      let slot = getAfter(/databases/$(database)/documents/librarySlots/$(d.slot)).data;
      return signedIn()
        && d.keys().hasAll(['id', 'kind', 'name', 'ownerId', 'ownerName', 'createdAt', 'model', 'resolution', 'promptVersion', 'assets', 'identityId', 'identityName', 'slot', 'state'])
        && d.keys().hasOnly(['id', 'kind', 'name', 'ownerId', 'ownerName', 'createdAt', 'model', 'resolution', 'promptVersion', 'assets', 'identityId', 'identityName', 'slot', 'state'])
        && d.id == recordId && d.ownerId == request.auth.uid && d.state == 'saving'
        && validSlot(d.slot, d.kind) && slot.recordId == d.id && slot.ownerId == d.ownerId && slot.kind == d.kind
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.ownerName is string && d.ownerName.size() <= 100 && d.createdAt is int
        && d.model is string && d.model.size() <= 120 && d.resolution in ['1K', '2K', '4K']
        && d.promptVersion is string && d.promptVersion.size() <= 80
        && d.identityId is string && d.identityName is string && d.identityName.size() <= 120
        && d.assets is map && d.assets.keys().hasAll(['front', 'back']) && d.assets.keys().hasOnly(['front', 'back'])
        && imageValid(d.assets.front, 'front', d) && imageValid(d.assets.back, 'back', d)
        && ((d.kind == 'identity' && d.identityId == '' && d.identityName == '')
          || (d.kind == 'swap' && d.identityId.size() > 0
            && get(/databases/$(database)/documents/records/$(d.identityId)).data.kind == 'identity'
            && get(/databases/$(database)/documents/records/$(d.identityId)).data.state == 'ready'
            && (!d.promptVersion.matches('.*swap-v5.*') || sameSwapDimensions(d))));
    }
    match /librarySlots/{slotId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['recordId', 'ownerId', 'kind'])
        && request.resource.data.keys().hasOnly(['recordId', 'ownerId', 'kind'])
        && request.resource.data.ownerId == request.auth.uid
        && validSlot(slotId, request.resource.data.kind)
        && getAfter(/databases/$(database)/documents/records/$(request.resource.data.recordId)).data.slot == slotId
        && getAfter(/databases/$(database)/documents/records/$(request.resource.data.recordId)).data.ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/records/$(resource.data.recordId));
    }
    match /records/{recordId} {
      allow read: if signedIn();
      allow create: if validRecord(recordId);
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state'])
        && ((resource.data.state == 'saving' && request.resource.data.state == 'ready')
          || request.resource.data.state == 'deleting');
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid && resource.data.state == 'deleting'
        && !existsAfter(/databases/$(database)/documents/librarySlots/$(resource.data.slot));
    }
    match /privateKeys/{uid} {
      allow get, delete: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['key', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['key', 'updatedAt'])
        && request.resource.data.key is string && request.resource.data.key.size() > 0 && request.resource.data.key.size() <= 256
        && request.resource.data.updatedAt is int;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
