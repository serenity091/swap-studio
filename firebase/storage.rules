rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function record(slot) {
      let allocation = firestore.get(/databases/(default)/documents/librarySlots/$(slot)).data;
      return firestore.get(/databases/(default)/documents/records/$(allocation.recordId)).data;
    }
    match /library/{slot}/{view} {
      function owned() { return request.auth != null && record(slot).ownerId == request.auth.uid; }
      function validImage() {
        let d = record(slot);
        return d.state == 'saving' && request.resource.metadata.recordId == d.id
          && request.resource.size == d.assets[view].bytes
          && request.resource.size > 0 && request.resource.size <= 16 * 1024 * 1024
          && request.resource.contentType == d.assets[view].mimeType
          && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      }
      allow read: if request.auth != null;
      allow create, update: if view in ['front', 'back'] && owned() && validImage();
      allow delete: if view in ['front', 'back'] && owned() && record(slot).state == 'deleting';
    }
    match /library/{slot}/{file} {
      function thumbnail() { return record(slot).assets[file == 'front-thumb' ? 'front' : 'back'].thumbnail; }
      function owned() { return request.auth != null && record(slot).ownerId == request.auth.uid; }
      allow create, update: if file in ['front-thumb', 'back-thumb'] && owned()
        && record(slot).state == 'saving' && request.resource.metadata.recordId == record(slot).id
        && request.resource.size == thumbnail().bytes
        && request.resource.size > 0 && request.resource.size <= 128 * 1024
        && request.resource.contentType == 'image/jpeg';
      // Always clean both fixed preview paths, including an interrupted older-client deletion.
      allow delete: if file in ['front-thumb', 'back-thumb'] && owned() && record(slot).state == 'deleting';
    }
    // Read-only compatibility while existing approved pairs are migrated.
    match /users/{userId}/{recordId}/{view} { allow read: if request.auth != null; }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
